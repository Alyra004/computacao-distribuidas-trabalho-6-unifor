    <operation name="ListarPlaylists"><soap:operation soapAction="ListarPlaylists"/><input><soap:body use="literal"/></input><output><soap:body use="literal"/></output></operation>
    <operation name="ObterPlaylist"><soap:operation soapAction="ObterPlaylist"/><input><soap:body use="literal"/></input><output><soap:body use="literal"/></output></operation>
    <operation name="CriarPlaylist"><soap:operation soapAction="CriarPlaylist"/><input><soap:body use="literal"/></input><output><soap:body use="literal"/></output></operation>
    <operation name="AtualizarPlaylist"><soap:operation soapAction="AtualizarPlaylist"/><input><soap:body use="literal"/></input><output><soap:body use="literal"/></output></operation>
