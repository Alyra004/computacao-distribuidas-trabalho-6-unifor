<?xml version="1.0" encoding="UTF-8"?>
<definitions
    xmlns="http://schemas.xmlsoap.org/wsdl/"
    xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
    xmlns:tns="http://unifor.br/distribuidos/streaming"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema"
    targetNamespace="http://unifor.br/distribuidos/streaming"
    name="StreamingService">

  <types>
    <xsd:schema targetNamespace="http://unifor.br/distribuidos/streaming" elementFormDefault="qualified">
      <!-- Modelos -->
      <xsd:complexType name="Usuario">
        <xsd:sequence>
          <xsd:element name="id" type="xsd:string"/>
          <xsd:element name="nome" type="xsd:string"/>
          <xsd:element name="idade" type="xsd:int"/>
        </xsd:sequence>
      </xsd:complexType>

      <xsd:complexType name="Musica">
        <xsd:sequence>
          <xsd:element name="id" type="xsd:string"/>
          <xsd:element name="nome" type="xsd:string"/>
          <xsd:element name="artista" type="xsd:string"/>
        </xsd:sequence>
      </xsd:complexType>

      <xsd:complexType name="Playlist">
        <xsd:sequence>
          <xsd:element name="id" type="xsd:string"/>
          <xsd:element name="nome" type="xsd:string"/>
          <xsd:element name="usuarioId" type="xsd:string"/>
          <xsd:element name="musicaIds" type="xsd:string" minOccurs="0" maxOccurs="unbounded"/>
        </xsd:sequence>
      </xsd:complexType>

      <!-- Requests / Responses -->
      <xsd:element name="ListarUsuariosRequest"><xsd:complexType/></xsd:element>
      <xsd:element name="ListarUsuariosResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="usuario" type="tns:Usuario" minOccurs="0" maxOccurs="unbounded"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:element name="ObterUsuarioRequest">
        <xsd:complexType><xsd:sequence><xsd:element name="id" type="xsd:string"/></xsd:sequence></xsd:complexType>
      </xsd:element>
      <xsd:element name="ObterUsuarioResponse">
        <xsd:complexType><xsd:sequence><xsd:element name="usuario" type="tns:Usuario"/></xsd:sequence></xsd:complexType>
      </xsd:element>

      <xsd:element name="CriarUsuarioRequest">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="id" type="xsd:string" minOccurs="0"/>
            <xsd:element name="nome" type="xsd:string"/>
            <xsd:element name="idade" type="xsd:int"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
      <xsd:element name="CriarUsuarioResponse">
        <xsd:complexType><xsd:sequence><xsd:element name="usuario" type="tns:Usuario"/></xsd:sequence></xsd:complexType>
      </xsd:element>

      <xsd:element name="AtualizarUsuarioRequest">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="id" type="xsd:string"/>
            <xsd:element name="nome" type="xsd:string"/>
            <xsd:element name="idade" type="xsd:int"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
      <xsd:element name="AtualizarUsuarioResponse">
        <xsd:complexType><xsd:sequence><xsd:element name="usuario" type="tns:Usuario"/></xsd:sequence></xsd:complexType>
      </xsd:element>

      <xsd:element name="RemoverUsuarioRequest">
        <xsd:complexType><xsd:sequence><xsd:element name="id" type="xsd:string"/></xsd:sequence></xsd:complexType>
      </xsd:element>
      <xsd:element name="RemoverUsuarioResponse">
        <xsd:complexType><xsd:sequence><xsd:element name="sucesso" type="xsd:boolean"/></xsd:sequence></xsd:complexType>
      </xsd:element>

      <xsd:element name="ListarMusicasRequest"><xsd:complexType/></xsd:element>
      <xsd:element name="ListarMusicasResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="musica" type="tns:Musica" minOccurs="0" maxOccurs="unbounded"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:element name="ObterMusicaRequest">
        <xsd:complexType><xsd:sequence><xsd:element name="id" type="xsd:string"/></xsd:sequence></xsd:complexType>
      </xsd:element>
      <xsd:element name="ObterMusicaResponse">
        <xsd:complexType><xsd:sequence><xsd:element name="musica" type="tns:Musica"/></xsd:sequence></xsd:complexType>
      </xsd:element>

      <xsd:element name="CriarMusicaRequest">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="id" type="xsd:string" minOccurs="0"/>
            <xsd:element name="nome" type="xsd:string"/>
            <xsd:element name="artista" type="xsd:string"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
      <xsd:element name="CriarMusicaResponse">
        <xsd:complexType><xsd:sequence><xsd:element name="musica" type="tns:Musica"/></xsd:sequence></xsd:complexType>
      </xsd:element>

      <xsd:element name="AtualizarMusicaRequest">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="id" type="xsd:string"/>
            <xsd:element name="nome" type="xsd:string"/>
            <xsd:element name="artista" type="xsd:string"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
      <xsd:element name="AtualizarMusicaResponse">
        <xsd:complexType><xsd:sequence><xsd:element name="musica" type="tns:Musica"/></xsd:sequence></xsd:complexType>
      </xsd:element>

      <xsd:element name="RemoverMusicaRequest">
        <xsd:complexType><xsd:sequence><xsd:element name="id" type="xsd:string"/></xsd:sequence></xsd:complexType>
      </xsd:element>
      <xsd:element name="RemoverMusicaResponse">
        <xsd:complexType><xsd:sequence><xsd:element name="sucesso" type="xsd:boolean"/></xsd:sequence></xsd:complexType>
      </xsd:element>

      <xsd:element name="ListarPlaylistsRequest"><xsd:complexType/></xsd:element>
      <xsd:element name="ListarPlaylistsResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="playlist" type="tns:Playlist" minOccurs="0" maxOccurs="unbounded"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:element name="ObterPlaylistRequest">
        <xsd:complexType><xsd:sequence><xsd:element name="id" type="xsd:string"/></xsd:sequence></xsd:complexType>
      </xsd:element>
      <xsd:element name="ObterPlaylistResponse">
        <xsd:complexType><xsd:sequence><xsd:element name="playlist" type="tns:Playlist"/></xsd:sequence></xsd:complexType>
      </xsd:element>

      <xsd:element name="CriarPlaylistRequest">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="id" type="xsd:string" minOccurs="0"/>
            <xsd:element name="nome" type="xsd:string"/>
            <xsd:element name="usuarioId" type="xsd:string"/>
            <xsd:element name="musicaIds" type="xsd:string" minOccurs="0" maxOccurs="unbounded"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
      <xsd:element name="CriarPlaylistResponse">
        <xsd:complexType><xsd:sequence><xsd:element name="playlist" type="tns:Playlist"/></xsd:sequence></xsd:complexType>
      </xsd:element>

      <xsd:element name="AtualizarPlaylistRequest">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="id" type="xsd:string"/>
            <xsd:element name="nome" type="xsd:string"/>
            <xsd:element name="usuarioId" type="xsd:string" minOccurs="0"/>
            <xsd:element name="musicaIds" type="xsd:string" minOccurs="0" maxOccurs="unbounded"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
      <xsd:element name="AtualizarPlaylistResponse">
        <xsd:complexType><xsd:sequence><xsd:element name="playlist" type="tns:Playlist"/></xsd:sequence></xsd:complexType>
      </xsd:element>

      <xsd:element name="RemoverPlaylistRequest">
        <xsd:complexType><xsd:sequence><xsd:element name="id" type="xsd:string"/></xsd:sequence></xsd:complexType>
      </xsd:element>
      <xsd:element name="RemoverPlaylistResponse">
        <xsd:complexType><xsd:sequence><xsd:element name="sucesso" type="xsd:boolean"/></xsd:sequence></xsd:complexType>
      </xsd:element>

      <xsd:element name="AdicionarMusicaNaPlaylistRequest">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="playlistId" type="xsd:string"/>
            <xsd:element name="musicaId" type="xsd:string"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
      <xsd:element name="AdicionarMusicaNaPlaylistResponse">
        <xsd:complexType><xsd:sequence><xsd:element name="playlist" type="tns:Playlist"/></xsd:sequence></xsd:complexType>
      </xsd:element>

      <xsd:element name="RemoverMusicaDaPlaylistRequest">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="playlistId" type="xsd:string"/>
            <xsd:element name="musicaId" type="xsd:string"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
      <xsd:element name="RemoverMusicaDaPlaylistResponse">
        <xsd:complexType><xsd:sequence><xsd:element name="playlist" type="tns:Playlist"/></xsd:sequence></xsd:complexType>
      </xsd:element>

      <!-- Consultas Relacionais (Slide 6) -->
      <xsd:element name="ListarPlaylistsPorUsuarioRequest">
        <xsd:complexType><xsd:sequence><xsd:element name="usuarioId" type="xsd:string"/></xsd:sequence></xsd:complexType>
      </xsd:element>
      <xsd:element name="ListarPlaylistsPorUsuarioResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="playlist" type="tns:Playlist" minOccurs="0" maxOccurs="unbounded"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:element name="ListarMusicasPorPlaylistRequest">
        <xsd:complexType><xsd:sequence><xsd:element name="playlistId" type="xsd:string"/></xsd:sequence></xsd:complexType>
      </xsd:element>
      <xsd:element name="ListarMusicasPorPlaylistResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="musica" type="tns:Musica" minOccurs="0" maxOccurs="unbounded"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:element name="ListarPlaylistsPorMusicaRequest">
        <xsd:complexType><xsd:sequence><xsd:element name="musicaId" type="xsd:string"/></xsd:sequence></xsd:complexType>
      </xsd:element>
      <xsd:element name="ListarPlaylistsPorMusicaResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="playlist" type="tns:Playlist" minOccurs="0" maxOccurs="unbounded"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
    </xsd:schema>
  </types>

  <!-- Messages & PortType -->
  <message name="ListarUsuariosInput"><part name="parameters" element="tns:ListarUsuariosRequest"/></message>
  <message name="ListarUsuariosOutput"><part name="parameters" element="tns:ListarUsuariosResponse"/></message>
  <message name="ObterUsuarioInput"><part name="parameters" element="tns:ObterUsuarioRequest"/></message>
  <message name="ObterUsuarioOutput"><part name="parameters" element="tns:ObterUsuarioResponse"/></message>
  <message name="CriarUsuarioInput"><part name="parameters" element="tns:CriarUsuarioRequest"/></message>
  <message name="CriarUsuarioOutput"><part name="parameters" element="tns:CriarUsuarioResponse"/></message>
  <message name="AtualizarUsuarioInput"><part name="parameters" element="tns:AtualizarUsuarioRequest"/></message>
  <message name="AtualizarUsuarioOutput"><part name="parameters" element="tns:AtualizarUsuarioResponse"/></message>
  <message name="RemoverUsuarioInput"><part name="parameters" element="tns:RemoverUsuarioRequest"/></message>
  <message name="RemoverUsuarioOutput"><part name="parameters" element="tns:RemoverUsuarioResponse"/></message>

  <message name="ListarMusicasInput"><part name="parameters" element="tns:ListarMusicasRequest"/></message>
