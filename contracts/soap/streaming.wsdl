  <message name="ObterMusicaInput"><part name="parameters" element="tns:ObterMusicaRequest"/></message>
  <message name="ObterMusicaOutput"><part name="parameters" element="tns:ObterMusicaResponse"/></message>
  <message name="CriarMusicaInput"><part name="parameters" element="tns:CriarMusicaRequest"/></message>
  <message name="CriarMusicaOutput"><part name="parameters" element="tns:CriarMusicaResponse"/></message>
  <message name="AtualizarMusicaInput"><part name="parameters" element="tns:AtualizarMusicaRequest"/></message>
  <message name="AtualizarMusicaOutput"><part name="parameters" element="tns:AtualizarMusicaResponse"/></message>
  <message name="RemoverMusicaInput"><part name="parameters" element="tns:RemoverMusicaRequest"/></message>
  <message name="RemoverMusicaOutput"><part name="parameters" element="tns:RemoverMusicaResponse"/></message>

  <message name="ListarPlaylistsInput"><part name="parameters" element="tns:ListarPlaylistsRequest"/></message>
  <message name="ListarPlaylistsOutput"><part name="parameters" element="tns:ListarPlaylistsResponse"/></message>
  <message name="ObterPlaylistInput"><part name="parameters" element="tns:ObterPlaylistRequest"/></message>
  <message name="ObterPlaylistOutput"><part name="parameters" element="tns:ObterPlaylistResponse"/></message>
  <message name="CriarPlaylistInput"><part name="parameters" element="tns:CriarPlaylistRequest"/></message>
  <message name="CriarPlaylistOutput"><part name="parameters" element="tns:CriarPlaylistResponse"/></message>
  <message name="AtualizarPlaylistInput"><part name="parameters" element="tns:AtualizarPlaylistRequest"/></message>
  <message name="AtualizarPlaylistOutput"><part name="parameters" element="tns:AtualizarPlaylistResponse"/></message>
  <message name="RemoverPlaylistInput"><part name="parameters" element="tns:RemoverPlaylistRequest"/></message>
  <message name="RemoverPlaylistOutput"><part name="parameters" element="tns:RemoverPlaylistResponse"/></message>
  <message name="AdicionarMusicaNaPlaylistInput"><part name="parameters" element="tns:AdicionarMusicaNaPlaylistRequest"/></message>
  <message name="AdicionarMusicaNaPlaylistOutput"><part name="parameters" element="tns:AdicionarMusicaNaPlaylistResponse"/></message>
