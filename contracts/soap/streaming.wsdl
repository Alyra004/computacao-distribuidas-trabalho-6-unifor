    <operation name="AtualizarMusica"><input message="tns:AtualizarMusicaInput"/><output message="tns:AtualizarMusicaOutput"/></operation>
    <operation name="RemoverMusica"><input message="tns:RemoverMusicaInput"/><output message="tns:RemoverMusicaOutput"/></operation>

    <operation name="ListarPlaylists"><input message="tns:ListarPlaylistsInput"/><output message="tns:ListarPlaylistsOutput"/></operation>
    <operation name="ObterPlaylist"><input message="tns:ObterPlaylistInput"/><output message="tns:ObterPlaylistOutput"/></operation>
    <operation name="CriarPlaylist"><input message="tns:CriarPlaylistInput"/><output message="tns:CriarPlaylistOutput"/></operation>
