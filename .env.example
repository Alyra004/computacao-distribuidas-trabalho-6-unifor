# ==============================================================================
# Trabalho 6 - Comparação de Tecnologias de Invocação de Serviços Remotos
# Variáveis de ambiente padrão (copie para .env se desejar customizar)
# ==============================================================================

# Dataset inicial compartilhado (para Docker Compose, use caminho /app/contracts/seed/...)
# Opções recomendadas:
# - contracts/seed/initial_data.json (padrão)
# - contracts/seed/seed_small.json   (10 usuários, 20 músicas, 15 playlists, 3-5 músicas/playlist)
# - contracts/seed/seed_large.json   (50 usuários, 500 músicas, 50 playlists, 200 músicas/playlist)
SEED_DATA_PATH=contracts/seed/initial_data.json

# Portas dos serviços Python
PYTHON_REST_PORT=8001
PYTHON_SOAP_PORT=8002
PYTHON_GRAPHQL_PORT=8003
PYTHON_GRPC_PORT=50051

# Portas dos serviços Java
JAVA_REST_PORT=8081
JAVA_SOAP_PORT=8082
JAVA_GRAPHQL_PORT=8083
JAVA_GRPC_PORT=50052

# Parâmetros padrão de benchmark (Locust)
BENCHMARK_USERS=10,50,100,200
BENCHMARK_RUN_TIME=30s
BENCHMARK_SPAWN_RATE=10
# Modos de carga: read | mixed | nested
WORKLOAD_MODE=read
